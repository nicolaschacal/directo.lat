# ─────────────────────────────────────────────────────────────
# Obligatorias para arrancar
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://escucha:CAMBIAR_PASSWORD@127.0.0.1:5432/escucha
DB_SSL=false
CRM_JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
# Cifra las claves que se cargan desde el panel. Si falta, se usa CRM_JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=
CRON_SECRET=CAMBIAR_POR_OTRO_SECRETO_LARGO
APP_TIMEZONE=America/Caracas

# ─────────────────────────────────────────────────────────────
# Opcionales: también se configuran desde Panel → Configuración →
# Integraciones. Lo que se cargue en el panel tiene prioridad.
# ─────────────────────────────────────────────────────────────

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Correo saliente (avisos a coordinadores)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# Primer administrador por línea de comandos (alternativa al asistente web)
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
CRM_ADMIN_NAME=
